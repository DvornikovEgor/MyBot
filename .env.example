# Ключ Google Gemini — https://aistudio.google.com/apikey
# Скопируй этот файл в .env и подставь свой ключ (сам .env в git не попадает).
GEMINI_API_KEY=

# Необязательно:
# GEMINI_MODEL=gemini-2.5-flash     # если имя модели изменится — сервер подберёт доступную сам
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# PORT=8000
# MYBOT_AI_FAKE=1                    # локальная заглушка вместо Gemini (для отладки UI без ключа)
